{
  "name": "iphone-duo-design-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Layout patterns, editable cards and an interactive fold lab for the foldable iPhone (iPhone Duo).",
  "license": "MIT",
  "scripts": {
    "render": "node scripts/render.cjs",
    "serve": "npx --yes http-server docs -p 8080 -c-1",
