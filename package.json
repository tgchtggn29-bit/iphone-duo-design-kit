    "sync-data": "node -e \"require('fs').copyFileSync('data/patterns.json','docs/patterns.json')\""
  },
  "devDependencies": {
    "playwright": "^1.48.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tgchtggn29-bit/iphone-duo-design-kit.git"
  },
  "keywords": ["iphone-duo", "foldable", "ios", "swiftui", "design-system", "layout", "adaptive-layout"]
}
